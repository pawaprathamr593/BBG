# Copy to .env and replace all placeholder passwords/secrets.
APP_ENV=dev
APP_DEBUG=true
MYSQL_DATABASE=bbg
MYSQL_USER=bbg_app
MYSQL_PASSWORD=replace_with_a_local_password
MYSQL_ROOT_PASSWORD=replace_with_a_local_root_password
NGINX_PORT=8080
FRONTEND_PORT=4200
PHPMYADMIN_PORT=8081

# Local Redis (internal Docker network only; no host port is published)
REDIS_HOST=redis
REDIS_PORT=6379
AUTH_EMAIL_OTP_TTL=600
AUTH_EMAIL_OTP_MAX_ATTEMPTS=5
AUTH_EMAIL_OTP_RESEND_COOLDOWN=60

# Authentication: generate the secret with openssl rand -hex 32.
AUTH_ACCESS_TOKEN_SECRET=replace_with_a_random_64_character_hex_secret
AUTH_ACCESS_TOKEN_TTL=900
AUTH_REFRESH_TOKEN_TTL=2592000
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_TOKEN_ISSUER=bbg
AUTH_TOKEN_AUDIENCE=bbg-web


# Social sign-in provider credentials (keep secrets in the ignored local .env)
BBG_API_BASE_URL=http://localhost:8080
BBG_FRONTEND_URL=http://localhost:4200
BBG_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
BBG_APPLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/apple/callback
APPLE_OAUTH_CLIENT_ID=
BBG_FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/facebook/callback
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
BBG_INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/instagram/callback
INSTAGRAM_OAUTH_CLIENT_ID=
INSTAGRAM_OAUTH_CLIENT_SECRET=

# SES sender identity must be verified in the configured AWS account/region.
AWS_SES_REGION=ap-south-1
AWS_SES_FROM_EMAIL=

# AWS S3 media storage
AWS_S3_BUCKET=your-bbg-media-bucket
AWS_DEFAULT_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace_with_aws_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_access_key
AWS_S3_URL_TTL_MINUTES=10
AWS_S3_MAX_UPLOAD_BYTES=10485760
