# Backend environment reference; Compose injects these values into PHP.
APP_ENV=dev
APP_DEBUG=true
DB_HOST=mysql
DB_PORT=3306
DB_NAME=bbg
DB_USER=bbg_app
DB_PASSWORD=replace_with_a_local_password

# Authentication (generate a private secret with: openssl rand -hex 32)
AUTH_ACCESS_TOKEN_SECRET=replace_with_a_random_64_character_hex_secret
AUTH_ACCESS_TOKEN_TTL=900
AUTH_REFRESH_TOKEN_TTL=2592000
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_TOKEN_ISSUER=bbg
AUTH_TOKEN_AUDIENCE=bbg-web
