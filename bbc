#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="${BBC_COMPOSE_FILE:-$ROOT_DIR/docker-compose.yml}"
ENV_FILE="${BBC_ENV_FILE:-$ROOT_DIR/.env}"
BACKUP_DIR="${BBC_BACKUP_DIR:-$ROOT_DIR/backups}"

if [[ ! -f "$COMPOSE_FILE" ]]; then
  echo "ERROR: docker-compose.yml not found at: $COMPOSE_FILE" >&2
  exit 1
fi

dc() {
  docker compose --project-directory "$ROOT_DIR" -f "$COMPOSE_FILE" --env-file "$ENV_FILE" "$@"
}

need_docker() {
  if ! docker info >/dev/null 2>&1; then
    echo "Docker Desktop is not running. Start it with: open -a Docker" >&2
    exit 1
  fi
}

usage() {
  cat <<'HELP'
BBC command-line manager

Usage:
  ./bbc start|stop|restart|status|logs|rebuild
  ./bbc php|frontend|mysql
  ./bbc backup
  ./bbc restore <backup.sql[.gz]>
  ./bbc health
  ./bbc deps [all|php|frontend]
  ./bbc git <git arguments...>
  ./bbc yii <Yii console arguments...>
  ./bbc help

Examples:
  ./bbc start
  ./bbc logs frontend
  ./bbc backup
  ./bbc restore backups/bbc_20261105_153000.sql.gz
  ./bbc deps
  ./bbc git status
  ./bbc git switch -c development
  ./bbc yii help
HELP
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  start)
    need_docker
    dc up -d
    dc ps
    ;;
  stop)
    need_docker
    dc stop
    ;;
  restart)
    need_docker
    dc restart
    dc ps
    ;;
  status)
    need_docker
    dc ps
    ;;
  logs)
    need_docker
    dc logs -f --tail=100 "$@"
    ;;
  rebuild)
    need_docker
    dc up -d --build --force-recreate
    dc ps
    ;;
  php|frontend|mysql)
    need_docker
    service="$cmd"
    if [[ "$service" == "mysql" ]]; then
      dc exec mysql sh
    else
      dc exec "$service" sh
    fi
    ;;
  backup)
    need_docker
    mkdir -p "$BACKUP_DIR"
    stamp="$(date '+%Y%m%d_%H%M%S')"
    out="$BACKUP_DIR/bbc_${stamp}.sql.gz"
    echo "Creating database backup: $out"
    dc exec -T mysql sh -c 'export MYSQL_PWD="$MYSQL_ROOT_PASSWORD"; exec mysqldump -uroot --single-transaction --routines --triggers --events "$MYSQL_DATABASE"' \
      | gzip > "$out"
    if [[ ! -s "$out" ]]; then
      rm -f "$out"
      echo "ERROR: backup file is empty." >&2
      exit 1
    fi
    echo "Backup completed: $out"
    ;;
  restore)
    need_docker
    backup="${1:-}"
    if [[ -z "$backup" ]]; then
      echo "Usage: ./bbc restore <backup.sql[.gz]>" >&2
      exit 2
    fi
    [[ "$backup" = /* ]] || backup="$ROOT_DIR/$backup"
    if [[ ! -f "$backup" ]]; then
      echo "ERROR: backup file not found: $backup" >&2
      exit 1
    fi
    echo "WARNING: This will overwrite objects in the configured database."
    echo "The existing MySQL Docker volume will NOT be deleted."
    read -r -p "Type RESTORE to continue: " confirm
    [[ "$confirm" == "RESTORE" ]] || { echo "Restore cancelled."; exit 1; }
    if [[ "$backup" == *.gz ]]; then
      gzip -dc "$backup" | dc exec -T mysql sh -c 'export MYSQL_PWD="$MYSQL_ROOT_PASSWORD"; exec mysql -uroot "$MYSQL_DATABASE"'
    else
      cat "$backup" | dc exec -T mysql sh -c 'export MYSQL_PWD="$MYSQL_ROOT_PASSWORD"; exec mysql -uroot "$MYSQL_DATABASE"'
    fi
    echo "Restore completed."
    ;;
  health)
    need_docker
    echo "=== Container status ==="
    dc ps
    echo
    echo "=== HTTP checks ==="
    for item in "Backend|http://localhost:8080" "Angular|http://localhost:4200" "phpMyAdmin|http://localhost:8081"; do
      name="${item%%|*}"
      url="${item#*|}"
      code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 8 "$url" || true)"
      if [[ "$code" =~ ^2[0-9][0-9]$|^3[0-9][0-9]$ ]]; then
        printf 'OK   %-12s %s (%s)\n' "$name" "$url" "$code"
      else
        printf 'FAIL %-12s %s (%s)\n' "$name" "$url" "${code:-no response}"
      fi
    done
    echo
    echo "=== MySQL check ==="
    if dc exec -T mysql sh -c 'export MYSQL_PWD="$MYSQL_ROOT_PASSWORD"; mysqladmin ping -h 127.0.0.1 -uroot --silent' >/dev/null 2>&1; then
      echo "OK   MySQL responds"
    else
      echo "FAIL MySQL is not responding"
      exit 1
    fi
    ;;
  deps)
    need_docker
    target="${1:-all}"
    case "$target" in
      all|php)
        echo "Installing PHP dependencies (Composer)..."
        dc exec php composer install
        ;;
    esac
    case "$target" in
      all|frontend)
        echo "Installing Angular dependencies (npm ci)..."
        dc exec frontend npm ci
        ;;
    esac
    if [[ "$target" != "all" && "$target" != "php" && "$target" != "frontend" ]]; then
      echo "Usage: ./bbc deps [all|php|frontend]" >&2
      exit 2
    fi
    ;;
      git)
    command -v git >/dev/null 2>&1 || {
      echo "ERROR: Git is not installed." >&2
      exit 1
    }
    cd "$ROOT_DIR"
    git "$@"
    ;;
  yii)
    need_docker
    if [[ ! -f "$ROOT_DIR/backend/yii" ]]; then
      echo "ERROR: backend/yii was not found. Check your Yii 3 console entrypoint." >&2
      echo "If your entrypoint has another name, run it with: docker compose exec php php <entrypoint> ..." >&2
      exit 1
    fi
    dc exec php php yii "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage
    exit 2
    ;;
esac
